--- /dev/null
+++ b/drivers/actuate/odrive_can/main.c
@@ -0,0 +1,613 @@
+/*
+ * Copyright Agroecology Lab 2026
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * ODrive CANSimple actuator driver.
+ *
+ * Implements the subset of the ODrive "CANSimple" protocol needed to arm,
+ * command, and read back one or more ODrive axes over a standard (11-bit)
+ * CAN bus, following the same actuate-app shape as drivers/actuate/vesc_can.
+ *
+ * Only VELOCITY and TORQUE input modes are implemented. POSITION mode is
+ * deliberately left out: it is defined in the Lizard firmware this replaces
+ * (ODriveMotor::position()) but is never actually called anywhere in that
+ * codebase's ODriveWheels class -- only speed() and power() are used in
+ * production -- so there is no verified reference for what an equivalent
+ * position input on the synapse Actuators topic should mean here. Add it
+ * once that's confirmed, rather than guessing the units/semantics.
+ *
+ * wheel_odometry.rotation is published in radians of axis rotation
+ * (turns * 2*pi), matching the only other actuate driver in this repo
+ * that populates this field (vesc_can). This is an assumption, not a
+ * verified contract -- confirm against whatever consumes
+ * topic_wheel_odometry before trusting it for localization.
+ *
+ * Reference: https://docs.odriverobotics.com/v/latest/manual/can-protocol.html
+ */
+
+#define DT_DRV_COMPAT cerebri_odrive_can_actuators
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/shell/shell.h>
+
+#include <zros/private/zros_node_struct.h>
+#include <zros/private/zros_pub_struct.h>
+#include <zros/private/zros_sub_struct.h>
+#include <zros/zros_node.h>
+#include <zros/zros_pub.h>
+#include <zros/zros_sub.h>
+
+/* match drivers/actuate/vesc_can's include family rather than pulling
+ * zephyr/drivers/can.h directly, so this builds the same way on whatever
+ * board/transport (incl. native_sim's socketcan passthrough) vesc_can does.
+ */
+#include <zephyr/net/socket.h>
+#include <zephyr/net/socketcan.h>
+#include <zephyr/net/socketcan_utils.h>
+
+#include <cerebri/core/perf_duration.h>
+#include <synapse_topic_list.h>
+
+LOG_MODULE_REGISTER(actuate_odrive_can, CONFIG_CEREBRI_ACTUATE_ODRIVE_CAN_LOG_LEVEL);
+
+#define ODRIVE_CAN_ACTUATORS_INIT_PRIORITY 90
+#define MY_STACK_SIZE                      4096
+#define MY_PRIORITY                        4
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+/* CANSimple command IDs (bottom 5 bits of the 11-bit arbitration ID) */
+#define ODRV_CMD_HEARTBEAT            0x001
+#define ODRV_CMD_ESTOP                0x002
+#define ODRV_CMD_GET_ERROR            0x003
+#define ODRV_CMD_SET_AXIS_STATE       0x007
+#define ODRV_CMD_GET_ENCODER_ESTIMATE 0x009
+#define ODRV_CMD_SET_CONTROLLER_MODE  0x00b
+#define ODRV_CMD_SET_INPUT_VEL        0x00d
+#define ODRV_CMD_SET_INPUT_TORQUE     0x00e
+#define ODRV_CMD_SET_LIMITS           0x00f
+#define ODRV_CMD_CLEAR_ERRORS         0x018
+
+#define ODRV_NODE_ID_MAX 63 /* CANSimple node id is 6 bits: 0-0x3F */
+
+/* Axis states */
+#define ODRV_AXIS_STATE_IDLE                1
+#define ODRV_AXIS_STATE_CLOSED_LOOP_CONTROL 8
+
+/* Controller modes */
+#define ODRV_CONTROL_MODE_TORQUE_CONTROL   1
+#define ODRV_CONTROL_MODE_VELOCITY_CONTROL 2
+#define ODRV_INPUT_MODE_PASSTHROUGH        1
+
+uint32_t g_send_count = 0;
+
+extern struct perf_duration control_latency;
+
+static void actuate_odrive_can_rx_callback(const struct device *dev, struct can_frame *frame,
+					    void *user_data);
+
+typedef enum odrive_can_type_t {
+	ODRIVE_CAN_TYPE_VELOCITY = 0,
+	ODRIVE_CAN_TYPE_TORQUE = 1,
+} odrive_can_type_t;
+
+struct actuator_odrive_can {
+	const char *label;
+	uint8_t index;
+	uint8_t node_id;
+	uint8_t version;
+	odrive_can_type_t type;
+	uint32_t velocity_limit_mturns_s; /* milli-turns/s, 0 = don't set (keep saved config) */
+	uint32_t current_limit_ma;        /* milliamps, 0 = don't set (keep saved config) */
+	struct can_filter rx_filter_heartbeat;
+	struct can_filter rx_filter_encoder;
+	struct context *ctx;
+	int8_t axis_state;  /* last state reported by the ODrive, -1 unknown */
+	uint32_t axis_error;
+	bool motor_error_flag;
+	int8_t requested_state; /* last axis state we commanded, -1 = none yet */
+	int8_t requested_mode;  /* last controller mode we commanded, -1 = none yet */
+	bool armed_prev;        /* to detect the disarmed->armed edge */
+	bool limits_sent;
+	bool boot_complete; /* true once we've heard at least one heartbeat */
+	double position;    /* raw ODrive turns */
+	double velocity;    /* raw ODrive turns / s */
+};
+
+struct context {
+	synapse_pb_Actuators actuators;
+	synapse_pb_WheelOdometry wheel_odometry;
+	synapse_pb_Status status;
+	struct zros_node node;
+	struct zros_sub sub_actuators, sub_status;
+	struct zros_pub pub_wheel_odometry;
+	struct k_sem running;
+	size_t stack_size;
+	k_thread_stack_t *stack_area;
+	struct k_thread thread_data;
+	uint8_t num_actuators;
+	struct actuator_odrive_can *actuator_odrive_cans;
+	const struct device *device;
+	bool ready;
+	bool fd;
+	const char *label;
+	uint16_t status_rate;
+	bool enable_pub_wheel_odom;
+};
+
+static int actuate_odrive_can_stop(struct context *ctx)
+{
+	int err = 0;
+	struct can_bus_err_cnt err_cnt;
+	enum can_state state;
+	ctx->ready = false;
+	err = can_get_state(ctx->device, &state, &err_cnt);
+	if (err != 0) {
+		LOG_ERR("%s - failed to get CAN controller state (%d)\n", ctx->label, err);
+		ctx->ready = false;
+		return err;
+	}
+
+	if (state != CAN_STATE_STOPPED) {
+		err = can_stop(ctx->device);
+		if (err != 0) {
+			LOG_ERR("%s - failed to stop (%d)\n", ctx->label, err);
+			return err;
+		}
+	}
+
+	return err;
+}
+
+static int actuate_odrive_can_init(struct context *ctx)
+{
+	int err = 0;
+	zros_node_init(&ctx->node, "actuate_odrive_can");
+	zros_sub_init(&ctx->sub_actuators, &ctx->node, &topic_actuators, &ctx->actuators, 1000);
+	zros_sub_init(&ctx->sub_status, &ctx->node, &topic_status, &ctx->status, 10);
+	zros_pub_init(&ctx->pub_wheel_odometry, &ctx->node, &topic_wheel_odometry,
+		      &ctx->wheel_odometry);
+
+	if (ctx->ready) {
+		LOG_ERR("%s - already initialized", ctx->label);
+		return 0;
+	}
+
+	if (!device_is_ready(ctx->device)) {
+		LOG_ERR("%s - device not ready\n", ctx->label);
+		ctx->ready = false;
+		return -1;
+	}
+
+	actuate_odrive_can_stop(ctx);
+
+	if (ctx->fd) {
+		err = can_set_mode(ctx->device, CAN_MODE_FD);
+		if (err != 0) {
+			LOG_ERR("%s - set mode FD failed (%d)\n", ctx->label, err);
+			return err;
+		}
+	}
+
+	err = can_start(ctx->device);
+	if (err != 0) {
+		LOG_ERR("%s - start failed\n", ctx->label);
+		return err;
+	}
+
+	/* add receive callbacks: one filter for Heartbeat, one for Get_Encoder_Estimates,
+	 * per axis. CANSimple uses standard (11-bit) IDs: (node_id << 5) | cmd_id.
+	 */
+	for (int i = 0; i < ctx->num_actuators; i++) {
+		struct actuator_odrive_can *act = &ctx->actuator_odrive_cans[i];
+
+		if (act->node_id > ODRV_NODE_ID_MAX) {
+			LOG_ERR("%s - odrive-node-id %d out of range (max %d)\n", act->label,
+				act->node_id, ODRV_NODE_ID_MAX);
+			return -EINVAL;
+		}
+
+		act->ctx = ctx;
+		act->axis_state = -1;
+		act->requested_state = -1;
+		act->requested_mode = -1;
+
+		act->rx_filter_heartbeat.flags = 0;
+		act->rx_filter_heartbeat.id = (act->node_id << 5) | ODRV_CMD_HEARTBEAT;
+		act->rx_filter_heartbeat.mask = CAN_STD_ID_MASK;
+		err = can_add_rx_filter(ctx->device, actuate_odrive_can_rx_callback, act,
+					 &act->rx_filter_heartbeat);
+		if (err < 0) {
+			LOG_ERR("%s - heartbeat filter setup failed (%d)\n", ctx->label, err);
+			return err;
+		}
+
+		act->rx_filter_encoder.flags = 0;
+		act->rx_filter_encoder.id = (act->node_id << 5) | ODRV_CMD_GET_ENCODER_ESTIMATE;
+		act->rx_filter_encoder.mask = CAN_STD_ID_MASK;
+		err = can_add_rx_filter(ctx->device, actuate_odrive_can_rx_callback, act,
+					 &act->rx_filter_encoder);
+		if (err < 0) {
+			LOG_ERR("%s - encoder filter setup failed (%d)\n", ctx->label, err);
+			return err;
+		}
+	}
+
+	ctx->ready = true;
+	LOG_DBG("%s - connected and properly initialized.\n", ctx->label);
+	k_sem_take(&ctx->running, K_FOREVER);
+	LOG_INF("init");
+	return 0;
+}
+
+static int actuate_odrive_can_fini(struct context *ctx)
+{
+	actuate_odrive_can_stop(ctx);
+	zros_sub_fini(&ctx->sub_actuators);
+	zros_sub_fini(&ctx->sub_status);
+	zros_pub_fini(&ctx->pub_wheel_odometry);
+	zros_node_fini(&ctx->node);
+	k_sem_give(&ctx->running);
+	LOG_INF("fini");
+	return 0;
+}
+
+static void actuate_odrive_can_rx_callback(const struct device *dev, struct can_frame *frame,
+					    void *user_data)
+{
+	struct actuator_odrive_can *act = (struct actuator_odrive_can *)user_data;
+	struct context *ctx = act->ctx;
+	uint32_t cmd_id = frame->id & 0x1f;
+
+	if (cmd_id == ODRV_CMD_HEARTBEAT && frame->dlc >= can_bytes_to_dlc(5)) {
+		act->boot_complete = true;
+		uint32_t axis_error;
+		memcpy(&axis_error, &frame->data[0], 4);
+		act->axis_error = axis_error;
+		act->axis_state = frame->data[4];
+		if (act->version == 6 && frame->dlc >= can_bytes_to_dlc(6)) {
+			act->motor_error_flag = frame->data[5] & 0x01;
+		}
+		return;
+	}
+
+	if (cmd_id == ODRV_CMD_GET_ENCODER_ESTIMATE && frame->dlc >= can_bytes_to_dlc(8)) {
+		float pos_estimate, vel_estimate;
+		memcpy(&pos_estimate, &frame->data[0], 4);
+		memcpy(&vel_estimate, &frame->data[4], 4);
+		act->position = pos_estimate;
+		act->velocity = vel_estimate;
+
+		/* pointer identity, not act->id (which vesc_can also never sets --
+		 * comparing an always-zero field matched on every axis, not just
+		 * the first one).
+		 */
+		if (act == &ctx->actuator_odrive_cans[0]) {
+			double mean_turns = 0;
+			for (int i = 0; i < ctx->num_actuators; i++) {
+				mean_turns += ctx->actuator_odrive_cans[i].position;
+			}
+			mean_turns /= ctx->num_actuators;
+			ctx->wheel_odometry.has_stamp = true;
+			stamp_msg(&ctx->wheel_odometry.stamp, k_uptime_ticks());
+			ctx->wheel_odometry.rotation = mean_turns * 2 * M_PI;
+		}
+		return;
+	}
+}
+
+static int actuate_odrive_can_send(struct context *ctx, struct actuator_odrive_can *act,
+				    uint32_t cmd_id, const uint8_t *data, uint8_t len)
+{
+	struct can_frame frame = {
+		.id = (act->node_id << 5) | cmd_id,
+		.dlc = can_bytes_to_dlc(len),
+		.flags = 0,
+	};
+	memset(frame.data, 0, sizeof(frame.data));
+	if (data != NULL) {
+		memcpy(frame.data, data, len);
+	}
+	g_send_count += 1;
+	return can_send(ctx->device, &frame, K_NO_WAIT, NULL, NULL);
+}
+
+static int actuate_odrive_can_clear_errors(struct context *ctx, struct actuator_odrive_can *act)
+{
+	int err = actuate_odrive_can_send(ctx, act, ODRV_CMD_CLEAR_ERRORS, NULL, 0);
+	if (err == 0) {
+		act->motor_error_flag = false;
+	}
+	return err;
+}
+
+static int actuate_odrive_can_set_limits(struct context *ctx, struct actuator_odrive_can *act)
+{
+	if (act->velocity_limit_mturns_s == 0 && act->current_limit_ma == 0) {
+		return 0; /* not configured -- keep whatever is already saved on the axis */
+	}
+	float vel_limit = act->velocity_limit_mturns_s / 1000.0f; /* turns/s */
+	float current_limit = act->current_limit_ma / 1000.0f;    /* A */
+	uint8_t data[8] = {0};
+	memcpy(&data[0], &vel_limit, 4);
+	memcpy(&data[4], &current_limit, 4);
+	return actuate_odrive_can_send(ctx, act, ODRV_CMD_SET_LIMITS, data, 8);
+}
+
+static int actuate_odrive_can_set_axis_state(struct context *ctx, struct actuator_odrive_can *act,
+					      uint8_t state)
+{
+	if (act->requested_state == state) {
+		return 0;
+	}
+	uint8_t data[4] = {0};
+	memcpy(data, &state, 1);
+	int err = actuate_odrive_can_send(ctx, act, ODRV_CMD_SET_AXIS_STATE, data, 4);
+	if (err == 0) {
+		act->requested_state = state;
+	}
+	return err;
+}
+
+static int actuate_odrive_can_set_controller_mode(struct context *ctx,
+						   struct actuator_odrive_can *act,
+						   uint8_t control_mode, uint8_t input_mode)
+{
+	int8_t combined = (int8_t)((control_mode << 4) | input_mode);
+	if (act->requested_mode == combined) {
+		return 0;
+	}
+	uint8_t data[8] = {0};
+	int32_t cm = control_mode;
+	int32_t im = input_mode;
+	memcpy(&data[0], &cm, 4);
+	memcpy(&data[4], &im, 4);
+	int err = actuate_odrive_can_send(ctx, act, ODRV_CMD_SET_CONTROLLER_MODE, data, 8);
+	if (err == 0) {
+		act->requested_mode = combined;
+	}
+	return err;
+}
+
+static void actuate_odrive_can_update(struct context *ctx)
+{
+	bool armed = ctx->status.arming == synapse_pb_Status_Arming_ARMING_ARMED;
+	int err = 0;
+
+	for (int i = 0; i < ctx->num_actuators; i++) {
+		struct actuator_odrive_can *act = &ctx->actuator_odrive_cans[i];
+
+		if (!act->boot_complete) {
+			continue;
+		}
+
+		if (act->motor_error_flag) {
+			/* let the axis fault; don't keep commanding it until cleared */
+			act->requested_state = -1;
+			act->requested_mode = -1;
+			act->armed_prev = false;
+			continue;
+		}
+
+		if (!armed) {
+			actuate_odrive_can_set_axis_state(ctx, act, ODRV_AXIS_STATE_IDLE);
+			act->armed_prev = false;
+			act->limits_sent = false;
+			continue;
+		}
+
+		if (!act->armed_prev) {
+			/* rising edge disarmed->armed: mirrors ODriveMotor::enable() in the
+			 * Lizard firmware, which clears motor errors on every (re)arm.
+			 */
+			actuate_odrive_can_clear_errors(ctx, act);
+			act->armed_prev = true;
+		}
+
+		if (!act->limits_sent) {
+			if (actuate_odrive_can_set_limits(ctx, act) == 0) {
+				act->limits_sent = true;
+			}
+		}
+
+		uint8_t control_mode = (act->type == ODRIVE_CAN_TYPE_TORQUE)
+						? ODRV_CONTROL_MODE_TORQUE_CONTROL
+						: ODRV_CONTROL_MODE_VELOCITY_CONTROL;
+
+		actuate_odrive_can_set_axis_state(ctx, act, ODRV_AXIS_STATE_CLOSED_LOOP_CONTROL);
+		actuate_odrive_can_set_controller_mode(ctx, act, control_mode,
+							ODRV_INPUT_MODE_PASSTHROUGH);
+
+		float input = (float)ctx->actuators.velocity[act->index];
+		uint8_t data[8] = {0};
+		uint32_t cmd_id;
+
+		if (act->type == ODRIVE_CAN_TYPE_TORQUE) {
+			cmd_id = ODRV_CMD_SET_INPUT_TORQUE;
+			memcpy(&data[0], &input, 4);
+		} else {
+			cmd_id = ODRV_CMD_SET_INPUT_VEL;
+			/* rad/s -> turns/s, ODrive's native Set_Input_Vel unit */
+			input = input / (2.0f * (float)M_PI);
+			memcpy(&data[0], &input, 4);
+		}
+
+		err = actuate_odrive_can_send(ctx, act, cmd_id, data, 8);
+		if (err != 0) {
+			ctx->ready = false;
+			LOG_ERR("%s - send failed to ODrive node: %d (%d)\n", act->label,
+				act->node_id, err);
+			continue;
+		}
+		perf_duration_stop(&control_latency);
+	}
+}
+
+static void actuate_odrive_can_run(void *p0, void *p1, void *p2)
+{
+	struct context *ctx = p0;
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+
+	int ret = actuate_odrive_can_init(ctx);
+
+	if (ret < 0) {
+		actuate_odrive_can_fini(ctx);
+		return;
+	}
+
+	struct k_poll_event events[] = {
+		*zros_sub_get_event(&ctx->sub_actuators),
+	};
+
+	while (k_sem_take(&ctx->running, K_NO_WAIT) < 0) {
+		int rc = 0;
+		rc = k_poll(events, ARRAY_SIZE(events), K_MSEC(1000));
+		if (rc != 0) {
+			LOG_DBG("no actuator message received");
+			if (ctx->status.arming == synapse_pb_Status_Arming_ARMING_ARMED) {
+				ctx->status.arming = synapse_pb_Status_Arming_ARMING_DISARMED;
+				LOG_ERR("Disarming motors due to actuator msg timeout!");
+			}
+		}
+
+		if (zros_sub_update_available(&ctx->sub_status)) {
+			zros_sub_update(&ctx->sub_status);
+		}
+
+		if (zros_sub_update_available(&ctx->sub_actuators)) {
+			zros_sub_update(&ctx->sub_actuators);
+		}
+
+		zros_pub_update(&ctx->pub_wheel_odometry);
+
+		actuate_odrive_can_update(ctx);
+	}
+
+	actuate_odrive_can_fini(ctx);
+}
+
+static int start(struct context *ctx)
+{
+	__ASSERT_NO_MSG(ctx != NULL);
+	k_tid_t tid =
+		k_thread_create(&ctx->thread_data, ctx->stack_area, ctx->stack_size,
+				actuate_odrive_can_run, ctx, NULL, NULL, MY_PRIORITY, 0, K_FOREVER);
+	k_thread_name_set(tid, "actuate_odrive_can");
+	k_thread_start(tid);
+	return 0;
+}
+
+static int actuate_odrive_can_cmd_handler(const struct shell *sh, size_t argc, char **argv,
+					   void *data)
+{
+	ARG_UNUSED(argc);
+	struct context *ctx = data;
+	__ASSERT_NO_MSG(data != NULL);
+
+	if (strcmp(argv[0], "start") == 0) {
+		if (k_sem_count_get(&ctx->running) == 0) {
+			shell_print(sh, "already running");
+		} else {
+			start(ctx);
+		}
+	} else if (strcmp(argv[0], "stop") == 0) {
+		if (k_sem_count_get(&ctx->running) == 0) {
+			k_sem_give(&ctx->running);
+		} else {
+			shell_print(sh, "not running");
+		}
+	} else if (strcmp(argv[0], "status") == 0) {
+		shell_print(sh, "running: %d", (int)k_sem_count_get(&ctx->running) == 0);
+		for (int i = 0; i < ctx->num_actuators; i++) {
+			struct actuator_odrive_can *act = &ctx->actuator_odrive_cans[i];
+			shell_print(sh,
+				    "  node %d: state=%d error=0x%08x motor_error=%d "
+				    "pos=%.3f turns vel=%.3f turns/s",
+				    act->node_id, act->axis_state, act->axis_error,
+				    act->motor_error_flag, act->position, act->velocity);
+		}
+	} else if (strcmp(argv[0], "clear_errors") == 0) {
+		for (int i = 0; i < ctx->num_actuators; i++) {
+			actuate_odrive_can_clear_errors(ctx, &ctx->actuator_odrive_cans[i]);
+		}
+	} else {
+		shell_print(sh, "unknown command");
+	}
+	return 0;
+}
+
+static int actuate_odrive_can_device_init(const struct device *dev)
+{
+	struct context *data = dev->data;
+	start(data);
+	return 0;
+}
+
+#define ODRIVE_CAN_ACTUATOR_SHELL(inst)                                                          \
+	SHELL_SUBCMD_DICT_SET_CREATE(                                                            \
+		sub_actuate_odrive_can_##inst, actuate_odrive_can_cmd_handler,                   \
+		(start, &data_##inst, "start"), (stop, &data_##inst, "stop"),                    \
+		(status, &data_##inst, "status"),                                                 \
+		(clear_errors, &data_##inst, "clear_errors"));                                   \
+	SHELL_CMD_REGISTER(actuate_odrive_can_##inst, &sub_actuate_odrive_can_##inst,            \
+			   "actuate_odrive_can commands", NULL);
+
+#define ODRIVE_CAN_ACTUATOR_DEFINE(node_id)                                                      \
+	{                                                                                          \
+		.label = DT_NODE_FULL_NAME(node_id),                                              \
+		.index = DT_PROP(node_id, input_index),                                          \
+		.node_id = DT_PROP(node_id, odrive_node_id),                                     \
+		.version = DT_PROP_OR(node_id, odrive_version, 6),                                \
+		.type = DT_ENUM_IDX(node_id, input_type),                                        \
+		.velocity_limit_mturns_s = DT_PROP_OR(node_id, velocity_limit_mturns_s, 0),       \
+		.current_limit_ma = DT_PROP_OR(node_id, current_limit_ma, 0),                    \
+		.rx_filter_heartbeat = {},                                                        \
+		.rx_filter_encoder = {},                                                          \
+		.ctx = NULL,                                                                      \
+		.axis_state = -1,                                                                 \
+		.axis_error = 0,                                                                  \
+		.motor_error_flag = false,                                                        \
+		.requested_state = -1,                                                            \
+		.requested_mode = -1,                                                             \
+		.armed_prev = false,                                                              \
+		.limits_sent = false,                                                             \
+		.boot_complete = false,                                                           \
+		.position = 0,                                                                    \
+		.velocity = 0,                                                                    \
+	},
+
+#define ODRIVE_CAN_ACTUATORS_DEFINE(inst)                                                        \
+	static struct actuator_odrive_can g_actuator_odrive_cans_##inst[] = {                    \
+		DT_FOREACH_CHILD(DT_DRV_INST(inst), ODRIVE_CAN_ACTUATOR_DEFINE)};                \
+	static K_THREAD_STACK_DEFINE(g_my_stack_area_##inst, MY_STACK_SIZE);                     \
+	static struct context data_##inst = {                                                    \
+		.actuators = synapse_pb_Actuators_init_default,                                  \
+		.status = synapse_pb_Status_init_default,                                        \
+		.node = {},                                                                       \
+		.sub_status = {},                                                                 \
+		.sub_actuators = {},                                                              \
+		.running = Z_SEM_INITIALIZER(data_##inst.running, 1, 1),                         \
+		.stack_size = MY_STACK_SIZE,                                                      \
+		.stack_area = g_my_stack_area_##inst,                                             \
+		.thread_data = {},                                                                \
+		.actuator_odrive_cans = g_actuator_odrive_cans_##inst,                            \
+		.num_actuators = DT_CHILD_NUM(DT_DRV_INST(inst)),                                 \
+		.device = DEVICE_DT_GET(DT_INST_PROP(inst, device)),                              \
+		.ready = false,                                                                   \
+		.fd = DT_INST_PROP(inst, fd),                                                     \
+		.status_rate = DT_INST_PROP(inst, status_rate),                                  \
+		.enable_pub_wheel_odom = DT_INST_PROP(inst, pub_wheel_odometry),                  \
+		.label = DT_NODE_FULL_NAME(DT_DRV_INST(inst)),                                   \
+	};                                                                                        \
+	ODRIVE_CAN_ACTUATOR_SHELL(inst);                                                          \
+	DEVICE_DT_INST_DEFINE(inst, actuate_odrive_can_device_init, NULL, &data_##inst, NULL,     \
+			      POST_KERNEL, ODRIVE_CAN_ACTUATORS_INIT_PRIORITY, NULL);
+
+DT_INST_FOREACH_STATUS_OKAY(ODRIVE_CAN_ACTUATORS_DEFINE)
